# Normalise line endings in the repository (LF stored, native on checkout).
* text=auto

*.py    text
*.md    text
*.txt   text
*.yml   text
*.yaml  text
*.csv   text
*.json  text

# Binaries git must never touch or try to diff.
*.xlsx   binary
*.png    binary
*.jpg    binary
*.joblib binary
*.npy    binary
